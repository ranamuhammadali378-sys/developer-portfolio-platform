{
  "name": "developer-portfolio-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack dynamically managed developer portfolio platform with Admin CMS",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:shared": "npm --workspace=packages/shared run build -- --watch",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "test:backend": "npm --workspace=backend test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}